#!/bin/sh
PREREQ=""
prereqs() {
         echo "$PREREQ"
}
case $1 in 
# get pre-requisites 
prereqs)
         prereqs
         exit 0
         ;; esac
# fbcp 

BASEDIR="$(dirname ""$(readlink -f ""$0"")"")/splash"
. /usr/share/initramfs-tools/hook-functions
if [ -f "${BASEDIR}/fbsplash.png" ]; then
  mkdir -p ${DESTDIR}/etc/splash
  echo imagefile=splash.png > ${DESTDIR}/etc/splash/splash.config
  echo fullscreen=0 >> ${DESTDIR}/etc/splash/splash.config
  echo stretch=0 >> ${DESTDIR}/etc/splash/splash.config
  echo plymouth=0 >> ${DESTDIR}/etc/splash/splash.config
  chmod 644 ${DESTDIR}/etc/splash/splash.config
  cp -f "${BASEDIR}/fbsplash.png" ${DESTDIR}/etc/splash/splash.png
  chmod 644 ${DESTDIR}/etc/splash/splash.png
fi
if [ -f "${BASEDIR}/splash_plymouth" ] && [ -f "${BASEDIR}/splash_script" ]; then
  mkdir -p ${DESTDIR}/etc/splash
  cp -f "${BASEDIR}/splash_plymouth" ${DESTDIR}/etc/splash/splash_plymouth
  chmod 644 ${DESTDIR}/etc/splash/splash_plymouth
  cp -f "${BASEDIR}/splash_script" ${DESTDIR}/etc/splash/splash_script
  chmod 644 ${DESTDIR}/etc/splash/splash_script
fi
if [ -f "${BASEDIR}/fbsplash" ]; then
  cp -f "${BASEDIR}/fbsplash" ${DESTDIR}/bin
  chmod +x ${DESTDIR}/bin/fbsplash
fi
exit 0

#!/bin/sh

PREREQ="udev"
prereqs()
{
	echo "$PREREQ"
}
case $1 in
# get pre-requisites
prereqs)
	prereqs
	exit 0
	;;
esac

ROOT_FS="___ROOT_FS___"
ROOT_DEV="___ROOT_DEV___"
ROOT_MOUNT="false"
SIMG_MOUNT="false"
OIMG_MOUNT="false"
SHOW_SPLASH="false"

wait_for_udev() {
	command -v udevadm >/dev/null 2>&1 || return 0
	udevadm settle ${1:+--timeout=$1}
}

get_cmdline() {
  for x in $(cat /proc/cmdline)
  do
    case $x in
      root=*)
        ROOT_FS=${x#root=}
      ;;
      boot=*)
        BOOT_MODE=${x#boot=}
      ;;
      splash)
        SHOW_SPLASH="true"
      ;;
    esac
  done
}

get_file_size() {
  local file="$1"
  local size=""
  if [ ! -f "$file" ]; then
    echo "0"
    return
  fi
  if command -v stat >/dev/null 2>&1; then
    size=$(stat -c %s "$file" 2>/dev/null)
    if [ -n "$size" ]; then
      echo "$size"
      return
    fi
  fi
  if command -v awk >/dev/null 2>&1; then
    size=$(ls -l "$file" 2>/dev/null | awk '{print $5}')
    if [ -n "$size" ]; then
      echo "$size"
      return
    fi
  fi
  if command -v wc >/dev/null 2>&1; then
    size=$(wc -c < "$file" 2>/dev/null)
    if [ -n "$size" ]; then
      echo "$size"
      return
    fi
  fi
  echo "0"
}

get_devices() {
  [ "$ROOT_FS" == "___ROOT_FS___" ] && return 0
  wait_for_udev 10
  n=0
  until [ $n -ge 10 ]
  do
    case "$ROOT_FS" in
      LABEL=* | UUID=* | PARTLABEL=* | PARTUUID=*)
        ROOT_DEV="$(blkid -l -t "$ROOT_FS" -o device)" || ROOT_DEV="___ROOT_DEV___"
      ;;
    esac
    [ "$ROOT_DEV" != "___ROOT_DEV___" ] && break
    let "n=n+1"
    sleep 1.0
  done
}

mount_fs() {
  if [ "$ROOT_DEV" != "___ROOT_DEV___" ]; then 
    mkdir -p /mnt/tmproot
    if mount -r $ROOT_DEV /mnt/tmproot; then
      ROOT_MOUNT="true"
      if [ "$BOOT_MODE" == "image" ]; then
        if [ -f /mnt/tmproot/IMAGES/system.img ]; then
          mkdir -p /mnt/sysimg
          if mount -r -t ext4 /mnt/tmproot/IMAGES/system.img /mnt/sysimg; then
            SIMG_MOUNT="true"
          fi
        fi
        if [ -f /mnt/tmproot/IMAGES/oem.img ]; then
          mkdir -p /mnt/oemimg
          if mount -r -t ext4 /mnt/tmproot/IMAGES/oem.img /mnt/oemimg; then
            OIMG_MOUNT="true"
          fi
        fi
      fi
    fi
  fi
}

umount_fs() {
  local attempt=1
  sync >/dev/null 2>&1
  while [ "$SIMG_MOUNT" == "true" ] && [ $attempt -le 30 ]; do
    umount /mnt/sysimg >/dev/null 2>&1 && SIMG_MOUNT="false" || { sleep 1; attempt=$((attempt + 1)); }
  done
  attempt=1
  while [ "$OIMG_MOUNT" == "true" ] && [ $attempt -le 30 ]; do
    umount /mnt/oemimg >/dev/null 2>&1 && OIMG_MOUNT="false" || { sleep 1; attempt=$((attempt + 1)); }
  done
  attempt=1
  while [ "$ROOT_MOUNT" == "true" ] && [ $attempt -le 30 ]; do
    umount /mnt/tmproot >/dev/null 2>&1 && ROOT_MOUNT="false" || { sleep 1; attempt=$((attempt + 1)); }
  done
  [ "$SIMG_MOUNT" == "true" ] && echo "Could not umount: /mnt/sysimg"
  [ "$OIMG_MOUNT" == "true" ] && echo "Could not umount: /mnt/oemimg"
  [ "$ROOT_MOUNT" == "true" ] && echo "Could not umount: /mnt/tmproot"
}

show_splash() {
  local splashimg="splash.png"
  local splashpth="/etc/splash"
  local splashopt=
  [ -f "/mnt/tmproot/usr/lib/rpi-kiosk/kiosk-splash/splash.config" ] && splashpth="/mnt/tmproot/usr/lib/rpi-kiosk/kiosk-splash"
  [ -f "/mnt/sysimg/SYSTEM/usr/lib/rpi-kiosk/kiosk-splash/splash.config" ] && splashpth="/mnt/sysimg/SYSTEM/usr/lib/rpi-kiosk/kiosk-splash"
  [ -f "/mnt/oemimg/SYSTEM/usr/lib/rpi-kiosk/kiosk-splash/splash.config" ] && splashpth="/mnt/oemimg/SYSTEM/usr/lib/rpi-kiosk/kiosk-splash"
  [ -f "/mnt/tmproot/etc/splash/splash.config" ] && splashpth="/mnt/tmproot/etc/splash"
  [ -f "/mnt/sysimg/SYSTEM/etc/splash/splash.config" ] && splashpth="/mnt/sysimg/SYSTEM/etc/splash"
  [ -f "/mnt/oemimg/SYSTEM/etc/splash/splash.config" ] && splashpth="/mnt/oemimg/SYSTEM/etc/splash"
  [ -f "/mnt/tmproot/CONFIG/initramfs-splash/splash.config" ] && splashpth="/mnt/tmproot/CONFIG/initramfs-splash"
  if [ -f "$splashpth/splash.config" ]; then
    SPLASH_IMG=$(awk -F '=' '/^imagefile/{print $2}' "$splashpth/splash.config")
    SPLASH_FS=$(awk -F '=' '/^fullscreen/{print $2}' "$splashpth/splash.config")
    SPLASH_ASP=$(awk -F '=' '/^stretch/{print $2}' "$splashpth/splash.config")
  fi
  [ "$SPLASH_IMG" != "" ] && splashimg="$SPLASH_IMG"
  [ "$SPLASH_FS" = "1" ] && splashopt="--resize" || unset SPLASH_ASP
  [ "$SPLASH_ASP" = "1" ] && splashopt="--resize --freeaspect"
  if [ -f "$splashpth/$splashimg" ]; then
    local cfgsize=$(get_file_size "$splashpth/splash.config")
    local imgsize=$(get_file_size "$splashpth/$splashimg")
    if [ "$imgsize" -le "5242880" ] && [ "$imgsize" -ne "0" ]; then
      fbsplash $splashopt "$splashpth/$splashimg"
      if [ "$splashpth" != "/etc/splash" ]; then
        if [ "$cfgsize" -le "1048576" ] && [ "$cfgsize" -ne "0" ]; then
          rm -rf "/etc/splash" >/dev/null 2>&1
          mkdir -p "/etc/splash" >/dev/null 2>&1
          cp -f "$splashpth/splash.config" "/etc/splash/splash.config" >/dev/null 2>&1
          cp -f "$splashpth/$splashimg" "/etc/splash/$splashimg" >/dev/null 2>&1
        else
          echo "file: '$splashpth/splash.config'"
          echo "size: $cfgsize Bytes (max: 1048576 Bytes)"
          echo "... SPLASH CONFIG FILE EXCEEDS SIZE LIMIT!! ..."
        fi
      fi
    else
      echo "file: '$splashpth/$splashimg'"
      echo "size: $imgsize Bytes (max: 5242880 Bytes)"
      echo "... SPLASH IMAGE FILE EXCEEDS SIZE LIMIT!! ..."
    fi
  else
    echo "... SPLASH IMAGE NOT FOUND!! ..."
  fi
}

get_cmdline
if [ "$SHOW_SPLASH" == "true" ]; then
  [ -f "/etc/splash/splash.config" ] && show_splash && sleep 1.5
  get_devices
  mount_fs
  if [ -f "/mnt/tmproot/usr/lib/rpi-kiosk/kiosk-splash/splash.config" ] || [ -f "/mnt/sysimg/SYSTEM/usr/lib/rpi-kiosk/kiosk-splash/splash.config" ] || \
     [ -f "/mnt/oemimg/SYSTEM/usr/lib/rpi-kiosk/kiosk-splash/splash.config" ] || [ -f "/mnt/tmproot/etc/splash/splash.config" ] || \
     [ -f "/mnt/sysimg/SYSTEM/etc/splash/splash.config" ] || [ -f "/mnt/oemimg/SYSTEM/etc/splash/splash.config" ] || \
     [ -f "/mnt/tmproot/CONFIG/initramfs-splash/splash.config" ]; then
    show_splash && sleep 1.5
  elif [ ! -f "/etc/splash/splash.config" ]; then
    echo "... NO SPLASH CONFIG FOUND!! ..."
  fi
  umount_fs
fi
